# Cloudflare Pages response headers.
# The service worker and app shell must always be revalidated so new builds
# reach installed PWAs promptly. (Without this, sw.js was served max-age=14400.)
/sw.js
  Cache-Control: no-cache
/workbox-*.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# Content-hashed bundles never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
